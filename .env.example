# Datafordeler Administration, IT-system "bde-enrichment-engine" (dedicated BDE
# account — see docs/implementation-log.md, 2026-08-17). One API-key, used for
# BOTH BBR and CVR GraphQL access as of 2026-08-19 (free/open-data, account-wide).
DATAFORDELER_API_KEY=

# OAuth Shared Secret — only needed for protected/confidential CVR data (e.g. CVRPerson).
CVR_OAUTH_CLIENT_ID=
CVR_OAUTH_SHARED_SECRET=

# Legacy BBR REST credential (shared tjenestebruger from aarhus_re). No longer
# used as of 2026-08-19 - bbr.py migrated to GraphQL. Left here only for a
# possible rollback; see docs/implementation-log.md, 2026-08-19.
BBR_USERNAME=
BBR_PASSWORD=
